<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The "starter pack": Spring Boot decides which version of every library works well together,
         so we don't have to pick them one by one -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- The project's "name tag" -->
    <groupId>com.interestcalculator</groupId>
    <artifactId>interest-calculator</artifactId>
    <version>1.0.0</version>

    <properties>
        <!-- Which Java version the project is written for -->
        <java.version>21</java.version>
        <!-- Which class starts the web app (we have two starters: the console one and the web one) -->
        <start-class>com.interestcalculator.InterestCalculatorApplication</start-class>
    </properties>

    <dependencies>
        <!-- The web toolkit: a built-in web server plus the tools to answer web requests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- The rule-checking toolkit: lets us label fields like "must be greater than 0" -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- The testing toolkit (JUnit and friends). "test" scope = only used when testing,
             never included in the finished app -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lets Maven pack the whole app into one file that can run anywhere (needed in step 7) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
